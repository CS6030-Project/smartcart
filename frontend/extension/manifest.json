{
	"name": "SmartCart",
	"description": "SLOGAN",
	"version": "1.0",
	"manifest_version": 3,
	"action": {
		"default_popup": "popup.html",
		"default_icon": "smartcart.png"
	},
	"host_permissions": [
		"https://www.walmart.com/*",
		"http://127.0.0.1:5000/*"
	],"permissions": [
		"activeTab",
		"tabs",
		"scripting"
	]
}
